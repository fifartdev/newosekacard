# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payload / Database ───────────────────────────────────────────────────────
# Neon: copy from your project dashboard → "Connection string"
# For Vercel / serverless use the pooled URL (has "-pooler" in the hostname)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── Apple Wallet ─────────────────────────────────────────────────────────────
# Register a Pass Type ID at developer.apple.com, then extract certs.
# See wallet-assets/certificates/README.md for the full extraction steps.
APPLE_PASS_TYPE_IDENTIFIER=pass.com.yourcompany.osekacard
APPLE_TEAM_IDENTIFIER=YOUR10CHARTEAMID
# Leave blank if you stripped the passphrase from signerKey.pem:
APPLE_KEY_PASSPHRASE=

# ── Google Wallet ─────────────────────────────────────────────────────────────
# 1. Create a Google Cloud project, enable the Google Wallet API.
# 2. Create a service account and download the JSON key.
# 3. Register your issuer at https://pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key value from the service account JSON (with \n escaped):
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
